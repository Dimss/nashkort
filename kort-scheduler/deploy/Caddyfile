# Installed by deploy/setup-vm.sh as /etc/caddy/Caddyfile with the hostname filled in.
# Caddy obtains and renews the certificate itself and redirects plain HTTP to HTTPS.
APP_HOSTNAME_PLACEHOLDER {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}
	reverse_proxy 127.0.0.1:3000
}

# Copy to /etc/court-scheduler/env on the VM (owner root, mode 0600).
# Public address of the app; Auth0 returns people here. No trailing slash.
BASE_URL=https://scheduler.example.com
# The one admin account: the email of your Auth0 account (case does not matter for sign-in;
# for the one-time cutover the legacy row must match it exactly, see README).
ADMIN_EMAIL=you@example.com
# Auth0 Regular Web Application (tenant domain without https://).
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Baileys log level: silent | error | warn | info | debug
WA_LOG_LEVEL=warn
# PORT and DATA_DIR are set by deploy/court-scheduler.service (3000 on loopback, ./data); do not set them here.

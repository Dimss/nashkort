# Port for the web UI (bound to 127.0.0.1)
PORT=3000
# Where WhatsApp credentials and the SQLite database are stored
DATA_DIR=./data
# Baileys log level: silent | error | warn | info | debug
WA_LOG_LEVEL=warn

# Required. Public address of the app as the browser sees it (no trailing slash).
# Locally: http://localhost:3000 (plain-http cookies are only allowed for local use).
BASE_URL=http://localhost:3000
# Required. The one admin account; matched against the Auth0 email, case-insensitive.
ADMIN_EMAIL=you@example.com
# Required. Auth0 Regular Web Application credentials.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
